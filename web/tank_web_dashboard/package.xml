<?xml version="1.0"?>
<package format="3">
  <name>tank_web_dashboard</name>
  <version>0.0.1</version>
  <description>Separated web dashboard for TankSimulation ROS2 topics</description>

  <maintainer email="tank@example.com">tank</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rviz_web</exec_depend>
  <exec_depend>rviz_visualization</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>